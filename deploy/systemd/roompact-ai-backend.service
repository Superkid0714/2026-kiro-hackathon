[Unit]
Description=RoomPACT AI Backend
After=network.target
ConditionPathExists=__ROOMPACT_APP_DIR__/backend/src/ai_backend/app.py

[Service]
Type=simple
User=ubuntu
WorkingDirectory=__ROOMPACT_APP_DIR__/backend
Environment=PYTHONPATH=__ROOMPACT_APP_DIR__/backend/src
ExecStart=__ROOMPACT_APP_DIR__/backend/.venv/bin/uvicorn ai_backend.app:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
