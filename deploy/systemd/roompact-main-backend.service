[Unit]
Description=RoomPACT Main Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=__ROOMPACT_APP_DIR__/backend
Environment=PYTHONPATH=__ROOMPACT_APP_DIR__/backend/src
ExecStart=__ROOMPACT_APP_DIR__/backend/.venv/bin/uvicorn main_backend.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
