              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}/match": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Run Session Match",
        "operationId": "run_session_match_sessions__session_id__match_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
