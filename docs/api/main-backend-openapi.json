              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProfileCreateRequest": {
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Nickname"
          },
          "age": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 17.0,
            "title": "Age"
          },
          "gender": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Gender"
          },
          "region": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Region"
          },
          "move_in_period": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Move In Period"
          },
          "stay_duration_months": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Stay Duration Months"
          }
        },
        "type": "object",
        "required": [
          "nickname",
          "age",
          "gender",
          "region",
          "move_in_period",
          "stay_duration_months"
        ],
        "title": "ProfileCreateRequest"
      },
      "SessionCreateRequest": {
        "properties": {
          "session_name": {
            "type": "string",
            "minLength": 1,
            "title": "Session Name"
          },
          "students": {
            "items": {
              "$ref": "#/components/schemas/StudentProfile"
            },
            "type": "array",
            "minItems": 2,
            "title": "Students"
          },
          "preset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Preset Id",
            "default": "default"
          }
        },
        "type": "object",
        "required": [
          "session_name",
          "students"
        ],
        "title": "SessionCreateRequest"
      },
      "StudentProfile": {
        "properties": {
          "student_id": {
            "type": "string",
            "minLength": 1,
            "title": "Student Id"
          },
          "lifestyle": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Lifestyle"
          },
          "required_rules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Rules"
          },
          "preferences": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Preferences"
          }
        },
        "type": "object",
        "required": [
          "student_id"
        ],
        "title": "StudentProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}